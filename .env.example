# ── Scraper run config ───────────────────────────────────────────────────────
# LOCATION maps to Planit's `auth` filter and must be a COUNCIL/authority KEY,
# e.g. "Croydon", "Camden", "Westminster" — NOT a region like "London".
# Leave EMPTY for the national recent-applications feed (no auth filter).
LOCATION=
DAYS_TO_FETCH=4
MAX_APPLICATIONS=5
# Optional absolute date-range window (YYYY-MM-DD). When START_DATE and/or END_DATE
# are set, the Planit feed is filtered by start_date instead of the rolling
# DAYS_TO_FETCH window (which is then ignored). Rules:
#   START_DATE only → START_DATE .. today
#   END_DATE only   → (END_DATE − 365 days) .. END_DATE
#   both set        → START_DATE .. END_DATE
# A future END_DATE is capped to today. Invalid format or END < START exits with
# code 1. Leave both empty to keep the rolling-window behaviour.
#   e.g. START_DATE=2024-01-01
#        END_DATE=2024-06-30
START_DATE=
END_DATE=
HEADLESS=true
TIMEOUT=45000

# ── Supabase (the real datastore) ────────────────────────────────────────────
# SUPABASE_SERVICE_ROLE_KEY must be the SECRET service-role key (legacy "eyJ…" JWT
# or "sb_secret_…"), NOT the publishable/anon key — writes & bucket ops need it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_DOCUMENTS_BUCKET=planning-documents

# ── Optional: distributed workers (BullMQ + Redis) ───────────────────────────
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=3

# ── Browser hardening ────────────────────────────────────────────────────────
BROWSER_SESSION_DIR=.sessions
BROWSER_TIMEZONE=Europe/London
BROWSER_LOCALE=en-GB
